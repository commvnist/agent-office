{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2023", "dom"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["packages/*/src", "scripts"]
}
